# test/harness/env.cloud.example
#
# 계층 2 검증용 — 진짜 Orchestrator(본인 Automation Cloud 테넌트)에 붙이고
# Webhook 과 Teams 는 mock 으로 둔다. 고객 환경도, 운영 서버도 건드리지 않는다.
#
#   cp test/harness/env.cloud.example test/harness/env.cloud
#   # AppId / AppSecret 두 줄만 채운다
#   bash test/harness/cloud-check.sh
#
# env.cloud 는 .gitignore 에 걸려 있다. 커밋되지 않는다.

# ── 진짜 Orchestrator ─────────────────────────────────────────
UiPathBaseURL="https://cloud.uipath.com"
UiPathOrganizationName="gilyongho"
UiPathTenantName="gilyongho"

# Automation Cloud 는 서비스 경로 세그먼트를 쓴다.
# 운영(Automation Suite)은 이 값을 비워 두고 동작한다 — 그 차이를 확인하는 것이
# 이 검증의 목적 중 하나다. cloud-check.sh 가 두 형태를 모두 던져본다.
UiPathOrchestratorPath="orchestrator_"

# Orchestrator URL 의 fid= 값. (LGU Cable Check 폴더)
UiPathFolderId="520137"

# 폴더 안의 Release 이름. cloud-check.sh 가 실제 목록을 찍어준다.
UiPathProcessName="LGUPLUSCableChecker"

# External Application 에 실제로 부여한 스코프만 적는다.
# 코드 기본값은 60개짜리라 그대로 두면 invalid_scope 로 떨어진다.
UiPathAuthScope="OR.Jobs OR.Execution OR.Folders.Read OR.Machines.Read"

# ── 여기 두 줄만 채운다 ───────────────────────────────────────
# Admin → External Applications → Add Application
#   Application Type : Confidential application
#   Resource         : Orchestrator API Access
#   Scopes           : 위 UiPathAuthScope 와 동일하게
UiPathAppId=""
UiPathAppSecret=""

# ── 상류 mock (진짜 Teams / 진짜 Maestro 로 나가지 않게) ──────
UiPathWebhookUrl="http://127.0.0.1:19000/webhook"
UiPathWebhookFormat="x-uipath-webhookkey"
UiPathWebhookKey="harness-key"
UiPathWebhookRetryAfter="2"

MicrosoftAppType="MultiTenant"
MicrosoftAppId=""
MicrosoftAppPassword=""
MicrosoftAppTenantId=""

# ── 운영과 겹치지 않는 포트 ──────────────────────────────────
MicrosoftAppPort=3979
MessageQueuePort=8081
MessageQueueApiKey="harness-mq-key"

# ── 재시작 경로를 실제로 확인하려면 true ─────────────────────
RestartOnTrigger=false
ProcessTriggerKeywords="에이전트 시작"
UiPathHttpTimeoutMs=15000

# 로컬 검증용 .env — 운영과 포트도 상류도 겹치지 않는다.
# 사용:  cp test/harness/env.harness .env.harness && node -r dotenv/config main.js dotenv_config_path=.env.harness

TeamsAppApiKey="harness-ta-key"
MessageQueueApiKey="harness-mq-key"

# ── 상류를 mock 으로 ──────────────────────────────────────────
UiPathBaseURL="http://127.0.0.1:19000"
UiPathOrganizationName="t"
UiPathTenantName="t"
UiPathFolderId="1"
UiPathProcessName="MockProcess"
UiPathOrchestratorPath=""
UiPathWebhookUrl="http://127.0.0.1:19000/webhook"
UiPathWebhookKey="harness-webhook-key"
UiPathWebhookFormat="x-uipath-webhookkey"
UiPathWebhookRetryAfter=1
UiPathASRobotName="[Default] Automation Suite Robot"

# ── Bot Framework: 인증 없는 로컬 모드 ────────────────────────
#   MultiTenant + 빈 AppId 는 botbuilder 의 에뮬레이터 모드다.
#   /api/messages 가 JWT 없이 활동을 받아들이므로 curl 로 대화를 주입할 수 있다.
MicrosoftAppType="MultiTenant"
MicrosoftAppId=""
MicrosoftAppPassword=""
MicrosoftAppTenantId=""

# ── 운영과 겹치지 않는 포트 ───────────────────────────────────
MicrosoftAppPort=3979
MessageQueuePort=8081

PollingIntervalSeconds=2
ProcessTriggerInterval=2
ProcessTriggerKeywords="AGENT시작,에이전트시작,다시시작"
TextFormat="plain"
LongNameLength=36
TaskOwnerIds=""

RestartOnTrigger=false
JobStopStrategy="Kill"
MaxStateCheckRetry=2
RestartCooldownMs=15000
MaxQueuePerUser=20
UiPathHttpTimeoutMs=5000
WebhookHttpTimeoutMs=5000
ProcessRunWatchdogMs=60000
TokenRecoveryIntervalSec=10

AppMessage1="M1 오류가 발생했습니다."
AppMessage2="M2 준비중입니다."
AppMessage3="M3 안녕하세요."
AppMessage5="M5 이전 작업이 실행중입니다."
AppMessage6="M6 종료하고 다시 시작합니다."
AppMessage7="M7 처리하지 못했습니다. 다시 입력해주세요."
AppMessage8="M8 진행 중인 대화가 없습니다. '에이전트 시작' 이라고 입력해주세요."
AppMessage9="M9 이전 작업을 정리하는 중입니다."

TeamsAppApiKey=""
MessageQueueApiKey=""
UiPathAppId=""
UiPathAppSecret=""
UiPathBaseURL="https://cloud.uipath.com"
UiPathOrganizationName="myorg"
UiPathTenantName="mytenant"
UiPathFolderId=""
UiPathProcessName="MyProcess"
UiPathWebhookUrl=""
UiPathWebhookKey=""
UiPathWebhookFormat=""
UiPathWebhookRetryAfter=1 # 첫번째 webhook 알림이 실패하면 이 시간만큼 기다렸다가 재시도함. seconds
                          # [R-1] 1차가 성공하면 2차는 보내지 않는다.
UiPathASRobotName="[Default] Automation Suite Robot"
MicrosoftAppId=""
MicrosoftAppPassword=""
MicrosoftAppType="SingleTenant"
MicrosoftAppTenantId=""
MicrosoftAppPort=3978
MessageQueuePort=8080
PollingIntervalSeconds=2
ProcessTriggerInterval=10 # seconds
# ⚠️ 트리거 키워드는 "명령어"여야 한다. 업무 어휘(거래선·협력사·신규 등)를 넣으면
#    사용자의 답변에 그 단어가 포함되는 순간 답변이 아니라 새 세션 요청으로 처리된다.
#    RestartOnTrigger=true 에서는 진행 중인 대화가 통째로 초기화된다.
ProcessTriggerKeywords="AGENT시작,에이전트시작,에이젼트시작,애이전트시작,애이젼트시작,이에전트시작,다시시작"
TextFormat="markdown" # Possible values: "markdown", "plain", or "xml"
# [D-7] 커밋 312ff30 에서 런타임 검사가 제거되어 현재 사용되지 않는다.
# RequiredRuntimes=-1
LongNameLength=36
TaskOwnerIds="" # ID list separated by space, e.g. "29:xxxx 29:yyyy"
AppMessage1="거래선 관리 Agent에서 오류가 발생했습니다.<br>다음에 시도해주시기 바랍니다."
AppMessage2="이전에 요청하신 거래선 등록 작업이 진행중인지 확인중입니다.<br>진행중인 작업이 없다면 신규 등록을 지원해 드리겠습니다.<br>잠시만 기다려주세요."
AppMessage3="안녕하세요. 저는 거래선 관리 Agent입니다.<br>무엇을 도와드릴까요?"
# [D-7] 런타임 부족 안내. 위와 같은 이유로 현재 사용되지 않는다.
# AppMessage4="지금 다른 작업을 실행중입니다.<br>잠시 후에 작업을 시작하겠습니다."
AppMessage5="이전에 요청하신 작업이 아직 실행중입니다.<br>그 작업이 종료된 후에 다시 요청해주세요."
# [D-15] RestartOnTrigger=true 이면 AppMessage5 는 Job 중지에 실패했을 때만 사용된다.
AppMessage6="진행 중이던 작업을 종료하고 처음부터 다시 시작합니다.<br>잠시만 기다려주세요."

# ── [D-15] 재시작 동작 ────────────────────────────────────────────────
# 실행 중인 Job 이 있을 때 트리거 키워드를 "재시작"으로 처리할지 여부.
# false 로 두면 종전처럼 AppMessage5 로 거부한다.
# 사용자가 트리거를 입력하는 상황은 대개 이전 Job 이 응답을 기다리며 살아 있는
# 상황이므로, 정작 재시작이 필요한 순간에 거부되는 문제가 있었다.
RestartOnTrigger=true

# Job 중지 방식. Kill(즉시) 또는 SoftStop(프로세스의 정지 지점까지 대기).
# 대화형 에이전트는 사용자 입력 대기 중 정지 지점에 도달하지 못할 수 있다.
JobStopStrategy="Kill"

# ── [D-8] Job 상태 조회 ───────────────────────────────────────────────
# 상태 조회가 연속 실패했을 때, 몇 번까지 기동을 보류할지.
# 임계치를 넘으면 중복 실행 위험을 감수하고 기동한다(영구 정지 방지).
MaxStateCheckRetry=3

# [D-15] 방금 기동한 Job 을 중복 트리거(더블탭·Bot Framework 재전송)가 다시 죽이지
# 않도록 하는 쿨다운. 이 시간 안에 들어온 트리거는 재시작으로 처리하지 않는다.
RestartCooldownMs=15000